{
  "geode": "v1.8.0",
  "gd": {
    "android": "*"
  },
  "id": "clicksafe.gd",
  "name": "ClickSafe GD",
  "version": "v1.0.0",
  "developer": "ClickSafe Team",
  "description": "Safe Mode para entradas táctiles.",
  "settings": {
    "stage": {
      "name": "Etapa de protección",
      "description": "Selecciona la ventana de diagnóstico.",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 3
    }
  }
}#include <Geode/Geode.hpp>
#include <Geode/modify/PlayLayer.hpp>

using namespace geode::prelude;

class $modify(ClickSafePlayLayer, PlayLayer) {
    struct Fields {
        int frames = 0;
        bool pressed = false;
    };

    void postUpdate(float dt) {
        PlayLayer::postUpdate(dt);

        auto stage = Mod::get()
            ->getSettingValue<int64_t>("stage");

        int limit = static_cast<int>(stage) * 30;

        if (m_fields->pressed) {
            ++m_fields->frames;

            if (m_fields->frames > limit) {
                m_fields->pressed = false;
                m_fields->frames = 0;
            }
        }
    }

    void handleButton(
        bool down,
        int button,
        bool isPlayer1
    ) {
        if (down) {
            m_fields->pressed = true;
            m_fields->frames = 0;
        } else {
            m_fields->pressed = false;
            m_fields->frames = 0;
        }

        PlayLayer::handleButton(
            down,
            button,
            isPlayer1
        );
    }
};